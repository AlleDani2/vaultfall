[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/screens/NewsScreen.gd" id="1"]

[node name="NewsScreen" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "UI_FB_NEWS_TITLE"

[node name="Version" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
auto_translate_mode = 2

[node name="Intro" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "UI_FB_NEWS_INTRO"
autowrap_mode = 3

[node name="Host" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
