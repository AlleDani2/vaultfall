[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/screens/ManualScreen.gd" id="1"]

[node name="ManualScreen" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "UI_QUESTS_MAN_TITLE"

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "UI_QUESTS_MAN_HINT"
autowrap_mode = 3

[node name="Search" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SearchField"
placeholder_text = "UI_MAN2_SEARCH_HINT"
clear_button_enabled = true

[node name="Split" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="PagesScroll" type="ScrollContainer" parent="Split"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Pages" type="VBoxContainer" parent="Split/PagesScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Body" type="RichTextLabel" parent="Split"]
unique_name_in_owner = true
auto_translate_mode = 2
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
selection_enabled = true
